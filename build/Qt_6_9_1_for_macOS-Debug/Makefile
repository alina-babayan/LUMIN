MyQtApp.app/Contents/PkgInfo: 
	@test -d MyQtApp.app/Contents || mkdir -p MyQtApp.app/Contents
	@$(DEL_FILE) MyQtApp.app/Contents/PkgInfo
	@echo "APPL????" > MyQtApp.app/Contents/PkgInfo
MyQtApp.app/Contents/Info.plist: 
	@test -d MyQtApp.app/Contents || mkdir -p MyQtApp.app/Contents
	@$(DEL_FILE) MyQtApp.app/Contents/Info.plist
	@plutil -convert xml1 -o - /Users/ina/Qt/6.9.1/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.MyQtApp,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.MyQtApp,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},12,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,MyQtApp,g" -e "s,@LIBRARY@,MyQtApp,g" -e "s,\$${EXECUTABLE_NAME},MyQtApp,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >MyQtApp.app/Contents/Info.plist

all: Makefile \
		MyQtApp.app/Contents/PkgInfo \
		MyQtApp.app/Contents/Info.plist MyQtApp.app/Contents/MacOS/MyQtApp

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../qml.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../../ApiEndPoints.h ../../QmlTypes.h ../../TokenStorage.h ../../apiclient.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../ApiEndpoints.cpp ../../QmlTypes.cpp ../../TokenStorage.cpp ../../apiclient.cpp ../../main.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) -r MyQtApp.app
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


